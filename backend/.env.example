# Local development values. For production see docs/DEPLOYMENT.md -- CORS_ORIGINS,
# FRONTEND_URL and GOOGLE_REDIRECT_URI MUST be changed or Google sign-in, realtime,
# and every API call from the deployed frontend will fail.

PORT=3001
NODE_ENV=development

# Comma-separated. Must include the deployed frontend origin in production, and this
# is also what Socket.IO validates against -- a wrong value breaks realtime and the
# API together. Vercel issues a separate URL per preview deployment, so include those
# too if you want previews to work against this backend.
CORS_ORIGINS=http://localhost:8443

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
DATABASE_URL=postgresql://REPLACE_ME

# Required only for Gmail outreach.
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:8443
